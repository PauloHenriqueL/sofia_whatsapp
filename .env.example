# Sofia — .env.example
# Copie para .env e preencha os valores. NUNCA faça commit de .env

# ============================================================================
# WHATSAPP CLOUD API (Meta Business)
# ============================================================================
# Quando a conta Business estiver pronta, preencher estes valores
# Docs: https://developers.facebook.com/docs/whatsapp/cloud-api

# Token permanente do system user (não usar token temporário de 24h)
WHATSAPP_TOKEN=EAABa...

# ID do número de telefone na Cloud API
WHATSAPP_PHONE_NUMBER_ID=102...

# String secreta para validar webhook (definida por nós, qualquer valor seguro)
WHATSAPP_VERIFY_TOKEN=sofia-verify-token-super-secreto-123

# App secret (usado pra validar X-Hub-Signature-256)
WHATSAPP_APP_SECRET=abc123def456...

# Número de Thainá para receber alertas (formato: 5531999998888)
THAINA_WHATSAPP_NUMBER=5531999998888

# Nome do template aprovado na Meta
ALERT_TEMPLATE_NAME=alerta_thaina

# ============================================================================
# OPENAI
# ============================================================================
OPENAI_API_KEY=sk-proj-...
# Produção usa gpt-5.6-terra ($2/$12 por 1M). O gpt-5.6-sol (alias gpt-5.6) é o
# topo de linha a $5/$30 e não se paga aqui: o turno da Sofia é seguir roteiro e
# escolher tool, não raciocinar.
OPENAI_MODEL=gpt-4o-mini
# Temperature da geração (0 a 2). Deixe VAZIO (ou "none") pra não enviar e usar
# o padrão do modelo — necessário em modelos novos que só aceitam o padrão.
# Se o modelo rejeitar o valor, a Sofia reenvia sem temperature automaticamente.
OPENAI_TEMPERATURE=0.7
# Esforço de raciocínio dos modelos gpt-5.x: none|low|medium|high|xhigh|max.
# Vazio (ou "none"/"default") = não envia e usa o padrão do modelo, que no 5.6 é
# "medium" — alguns segundos a mais em TODO turno, e tokens de raciocínio cobrados
# como saída. Por isso a conversa roda em `none`. A extração da pesquisa
# (conversa -> JSON) roda mais alta: ninguém está esperando, e errar ali contamina
# relatório. Modelo antigo que não conhece o parâmetro: a Sofia reenvia sem ele.
OPENAI_REASONING_EFFORT=none
OPENAI_REASONING_EFFORT_EXTRACAO=low

# ============================================================================
# BANCO DE DADOS (Postgres)
# ============================================================================
# Neon no desenvolvimento/produção
# Formato: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/sofia

# ============================================================================
# HAMILTON (API REST - Sistema clínico existente em Django)
# ============================================================================
# URL base do Hamilton
HAMILTON_API_URL=https://hamilton.allos.org.br

# Autenticação é JWT (SimpleJWT): a Sofia faz POST /authentication/token/ com
# usuário e senha de um usuário de serviço e usa o token Bearer retornado.
HAMILTON_USERNAME=sofia-bot
HAMILTON_PASSWORD=senha-do-usuario-de-servico

# (legado/opcional) Token estático, se um dia for usado.
HAMILTON_API_KEY=

# ============================================================================
# PAINEL WEB (Autenticação básica para MVP)
# ============================================================================
# Usuário para HTTP Basic Auth no painel (será Thainá)
PAINEL_USER=thaina

# Senha aleatória (gerar com: python -c "import secrets; print(secrets.token_urlsafe(32))")
PAINEL_PASSWORD=senha-super-secreta-aleatorio-123

# ============================================================================
# NEGÓCIO (valores que a Sofia fala)
# ============================================================================
# Agora a Thainá muda isso na tela "Configurações" do painel (salvo no banco).
# As variáveis abaixo são só o VALOR INICIAL (padrão) antes de mexer no painel.
# Mensalidade da terapia (R$/mês). Padrão: 200
PRECO_TERAPIA_MENSAL=200
# Orçamento da neuroavaliação (R$). Padrão: 1200
PRECO_NEURO=1200
# Parcelas máximas no cartão. Padrão: 5
PARCELAS_MAX=5

# ============================================================================
# TAREFAS / FOLLOW-UP (cron externo)
# ============================================================================
# Horas de silêncio do lead antes do follow-up automático (tem que ser < 24).
FOLLOWUP_HORAS=20
# Janela de agrupamento por conversa (segundos): a Sofia espera N segundos de
# silêncio antes de responder, pra juntar rajadas de mensagens (sugestão 4 a 8).
# EDITÁVEL no painel (Configurações) — aqui é só o valor inicial.
DEBOUNCE_SEGUNDOS=5
# Presença humana: "digitando…" + visto (tiques azuis). EDITÁVEL no painel
# (Configurações); aqui é só o valor inicial. true na produção.
SIMULAR_DIGITACAO=false
# Ouvir áudio do paciente (transcrever via Whisper e responder em texto).
# EDITÁVEL no painel (Configurações); desligado por padrão (custo por minuto).
TRANSCREVER_AUDIO=false
# Modelo de transcrição (STT). whisper-1 (padrão) ou gpt-4o-mini-transcribe.
OPENAI_AUDIO_MODEL=whisper-1
# Token do endpoint POST /tasks/seguimentos. Vazio = follow-up desligado.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(24))"
TASKS_TOKEN=

# ============================================================================
# STRIPE (links de pagamento gerados no painel)
# ============================================================================
# Secret key da conta Stripe (a MESMA do site da Allos). sk_test_ em teste,
# sk_live_ em produção. Vazio = tela de Pagamentos desligada (mostra aviso).
# ⚠ Dá controle total da conta financeira: só no Render, nunca commitada.
STRIPE_SECRET_KEY=
# Publishable key (pk_...). O checkout hospedado não usa; documentada por completude.
STRIPE_PUBLISHABLE_KEY=
# Preço mensal já cadastrado no Stripe (price_...). Quando a mensalidade pedida
# bate com o valor dele, a assinatura reusa esse preço (relatórios unificados).
STRIPE_PRECO_MENSAL_ID=
# Chaves do MODO DE TESTE. Nenhum código da app lê estas duas — existem só pro
# scripts/validar_parcelado.py, que roda o ciclo do parcelado com test clock
# (avança 6 meses e confere que a cobrança parou) sem tocar em dinheiro real.
# NÃO setar no Render.
TEST_STRIPE_SECRET_KEY=
TEST_STRIPE_PUBLISHABLE_KEY=
# URL pública da Sofia (monta as páginas de retorno do checkout). Sem barra final.
BASE_URL=https://sofia-whatsapp.onrender.com
# Prefixo do link curto de pagamento mandado ao paciente. Em produção:
# https://allos.org.br/p (exige o /p/[codigo] no repo do site apontando pra cá).
# Vazio = os links saem como {BASE_URL}/l/<slug>, que funciona igual — só não tem
# o domínio da Allos. Sem barra no final.
LINK_CURTO_BASE=

# ============================================================================
# APLICAÇÃO
# ============================================================================
# development ou production
ENVIRONMENT=development

# Nivel de log: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Host e porta do FastAPI
HOST=0.0.0.0
PORT=5000

# Chave secreta da aplicação (gerar com: python -c "import secrets; print(secrets.token_urlsafe(32))")
SECRET_KEY=chave-secreta-super-segura-aleatorio-456

# ============================================================================
# STRIPE — qual chave a app usa
# ============================================================================
# 🔴 Fora de ENVIRONMENT=production, a app usa a TEST_STRIPE_SECRET_KEY. Sempre.
#
# O Stripe não tem "dry run" como a Meta: toda chamada cria coisa de verdade.
# E este arquivo, quando copiado do Render, carrega uma chave sk_live_ — foi
# assim que um `pytest` criou 4 Payment Links na conta real, e a validação da
# cobrança criou mais um em 17/08/2026.
#
# Sem TEST_STRIPE_SECRET_KEY em dev, o Stripe fica DESLIGADO (a tela mostra
# aviso, a cobrança oferece só o Pix). **Nunca cai pra chave live**, e não há
# escotilha pra forçar — se precisar ver dado real, use o dashboard do Stripe.
#
# No código: `settings.stripe_key`, nunca `settings.stripe_secret_key`.
TEST_STRIPE_SECRET_KEY=
TEST_STRIPE_PUBLISHABLE_KEY=

# ============================================================================
# AUTENTIQUE (assinatura do contrato — Demanda E)
# ============================================================================
# ⚠️ TEMPORÁRIO NESTE REPO. Quem fala com a Autentique é o HAMILTON: é lá que o
# contrato é gerado e o PDF assinado é guardado. A chave está declarada aqui só
# porque o `.env` de desenvolvimento já a tem — e o pydantic-settings recusa
# chave desconhecida em arquivo de env, o que impede a app inteira de subir.
# Sai daqui quando a Demanda E for pro ar. Ver docs/demandas/05-contrato-assinatura.md
API_AUTHENTIC=

# ============================================================================
# RENDER (quando fazer deploy)
# ============================================================================
# Render fornecerá estes valores automaticamente:
# - DATABASE_URL (Postgres neon database)
# - Variáveis podem ser setadas no dashboard do Render
# Veja render.yaml para config do deploy
